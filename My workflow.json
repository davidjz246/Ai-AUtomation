    {
      "parameters": {
        "jsCode": "const parsedData = $('Code in JavaScript').first().json;\nconst sheetRows = $('Get row(s) in sheet').all();\n\nlet currentPrice = 0;\nlet matchedProduct = \"\";\nlet found = false;\n\nsheetRows.forEach((row) => {\n  if (row.json.Product && row.json.Product.toLowerCase() === parsedData.productName.toLowerCase()) {\n    currentPrice = parseFloat(row.json[\"Current price\"]);\n    matchedProduct = row.json.Product;\n    found = true;\n  }\n});\n\nif (!found) {\n  throw new Error(`Product \"${parsedData.productName}\" not found in Google Sheet.`);\n}\n\nconst increaseAmount = currentPrice * (parsedData.percentage / 100);\nconst newPrice = currentPrice + increaseAmount;\nconst fullMessage = `${matchedProduct} ${parsedData.percentage}%`;\n\nreturn [{\n  json: {\n    productName: matchedProduct,\n    newPrice: newPrice,\n    percentage: parsedData.percentage,\n    messageText: fullMessage,\n    chatId: parsedData.chatId\n  }\n}];"
      },
