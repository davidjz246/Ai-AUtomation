    {
      "parameters": {
        "jsCode": "const text = $input.item.json.message.text.trim();\n\n// Matches text followed by a space, a number, and an optional % symbol (e.g., \"Lenovo 10%\" or \"Lenovo 10\")\nconst match = text.match(/^(.*?)\\s+(\\d+)%?$/);\n\nif (!match) {\n  throw new Error(\"Invalid format! Send a message like: Lenovo 10%\");\n}\n\nreturn [{\n  json: {\n    productName: match[1].trim(),\n    percentage: parseFloat(match[2]),\n    chatId: $input.item.json.message.chat.id\n  }\n}];"
      },
