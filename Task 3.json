        "message": "=<!DOCTYPE html>\n<html>\n<body style=\"margin:0; padding:0; background-color:#f4f5f7; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"padding:24px 12px;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:540px; background-color:#ffffff; border-radius:10px; border:1px solid #e5e7eb; overflow:hidden;\">\n          <tr>\n            <td style=\"background-color:#059669; padding:20px 24px; text-align:center;\">\n              <h1 style=\"margin:0; font-size:20px; color:#ffffff;\">Thank You for Your Feedback!</h1>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:24px;\">\n              <p style=\"margin:0 0 12px; font-size:15px; line-height:1.6;\">\n                Hi <strong>{{ $('Merge').first().json.Name }}</strong>,\n              </p>\n              <p style=\"margin:0 0 14px; font-size:15px; line-height:1.6;\">\n                Thank you so much for taking the time to share your experience with us. We are thrilled to hear that you had a positive experience!\n              </p>\n              <div style=\"background-color:#f9fafb; border-left:4px solid #059669; padding:12px 16px; margin:16px 0; font-style:italic; color:#4b5563; font-size:14px;\">\n                \"{{ $('Merge').first().json.feedback }}\"\n              </div>\n              <p style=\"margin:14px 0 0; font-size:15px; line-height:1.6;\">\n                We truly appreciate your support and look forward to serving you again soon.\n              </p>\n              <p style=\"margin:20px 0 0; font-size:14px; color:#6b7280;\">\n                Best regards,<br><strong>Customer Experience Team</strong>\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
